model VersaoOrcamento {
  id           String                @id @default(uuid())
  companyId    String
  obraId       String
  numero       Int
  nome         String
  descricao    String?
  status       VersaoOrcamentoStatus @default(RASCUNHO)
  baseVersaoId String?
  total        Decimal               @default(0) @db.Decimal(18, 2)
  ativadoEm    DateTime?
  congeladoEm  DateTime?
  criadoPorId  String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  company      Company               @relation(fields: [companyId], references: [id])
  obra         Obra                  @relation(fields: [obraId], references: [id])
  baseVersao   VersaoOrcamento?      @relation("VersaoBase", fields: [baseVersaoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
