model ItemOrcamento {
  id            String               @id @default(uuid())
  versaoId      String
  etapaId       String?
  subetapaId    String?
  itemWbsId     String?
  centroCustoId String?
  categoriaId   String?
  descricao     String
  unidade       String               @default("UN")
  quantidade    Decimal              @db.Decimal(18, 4)
  valorUnitario Decimal              @db.Decimal(18, 4)
  valorTotal    Decimal              @db.Decimal(18, 2)
  ordem         Int                  @default(0)
  notas         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  versao        VersaoOrcamento      @relation(fields: [versaoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  etapa         ObraEtapa?           @relation(fields: [etapaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subetapa      ObraSubetapa?        @relation(fields: [subetapaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  itemWbs       ObraItemWBS?         @relation(fields: [itemWbsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  centroCusto   CentroCusto?         @relation(fields: [centroCustoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoria     CategoriaConstrucao? @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([versaoId])
  @@index([etapaId])
  @@index([subetapaId])
  @@index([itemWbsId])
  @@index([centroCustoId])
  @@index([categoriaId])
}

model TransacaoFinanceira {
  id                  String               @id @default(uuid())
  companyId           String
  obraId              String
  etapaId             String?
  subetapaId          String?
  itemWbsId           String?
  centroCustoId       String
  categoriaId         String
  supplierId          String?
  customerId          String?
  accountPayableId    String?
  accountReceivableId String?
  estornoDeId         String?              @unique
  tipo                TipoTransacao
  status              StatusTransacao      @default(PENDENTE)
  valor               Decimal              @db.Decimal(18, 2)
  descricao           String
  documento           String?
  dataReal            DateTime?
  dataCompetencia     DateTime
  dataPrevistaPgto    DateTime?
  observacoes         String?
  criadoPorId         String?
  confirmadoPorId     String?
  confirmadoEm        DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  company             Company              @relation(fields: [companyId], references: [id])
  obra                Obra                 @relation(fields: [obraId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  etapa               ObraEtapa?           @relation(fields: [etapaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subetapa            ObraSubetapa?        @relation(fields: [subetapaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  itemWbs             ObraItemWBS?         @relation(fields: [itemWbsId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  centroCusto         CentroCusto          @relation(fields: [centroCustoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoria           CategoriaConstrucao  @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountPayable      AccountPayable?      @relation(fields: [accountPayableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountReceivable   AccountReceivable?   @relation(fields: [accountReceivableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  estornoDe           TransacaoFinanceira? @relation("TransacaoEstorno", fields: [estornoDeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  estornoPor          TransacaoFinanceira? @relation("TransacaoEstorno")
  criadoPor           Users?               @relation("TransacaoCriadaPor", fields: [criadoPorId], references: [id])
  confirmadoPor       Users?               @relation("TransacaoConfirmadaPor", fields: [confirmadoPorId], references: [id])

  @@index([companyId])
  @@index([obraId])
  @@index([obraId, status])
  @@index([obraId, dataCompetencia])
  @@index([obraId, dataReal])
  @@index([centroCustoId])
  @@index([categoriaId])
  @@index([supplierId])
  @@index([accountPayableId])
  @@index([accountReceivableId])
  @@index([tipo, status])
  @@index([dataCompetencia])
  @@index([dataReal])
  @@index([deletedAt])
  @@index([etapaId])
  @@index([subetapaId])
  @@index([itemWbsId])
  @@index([criadoPorId])
  @@index([confirmadoPorId])
}

model AuditLog {
  id         String      @id @default(uuid())
  companyId  String
  userId     String?
  entity     String
  entityId   String
  action     AuditAction
  beforeJson Json?
  afterJson  Json?
  reason     String?
  createdAt  DateTime    @default(now())
  company    Company     @relation(fields: [companyId], references: [id])
  user       Users?      @relation(fields: [userId], references: [id])

