  companyId     String
  jid           String
  number        String?
  name          String?
  pushName      String?
  profilePicUrl String?
  picFetchedAt  DateTime?
  isMyContact   Boolean   @default(false)
  isGroup       Boolean   @default(false)
  syncedAt      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, jid])
  @@index([companyId])
  @@index([companyId, number])
}

model WhatsappChatbotRule {
  id                  String   @id @default(cuid())
  companyId           String
  name                String
  trigger             String
  pattern             String?
  responseBody        String
  priority            Int      @default(100)
  enabled             Boolean  @default(true)
  applyTags           String[]
  businessHoursOnly   Boolean  @default(false)
  businessHoursStart  String?
  businessHoursEnd    String?
  cooldownMinutes     Int      @default(60)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId, enabled, priority])
}

model WhatsappChatbotLog {
  id          String   @id @default(cuid())
  companyId   String
  ruleId      String
  peerNumber  String
  triggerText String?
  firedAt     DateTime @default(now())

  @@index([companyId, peerNumber, firedAt])
  @@index([ruleId])
}

model CompanyReminder {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  description String?
  category    String?
  priority    String    @default("normal")
  link        String?
  dueAt       DateTime
  doneAt      DateTime?
  notifiedAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, dueAt])
  @@index([companyId, doneAt])
}

model WhatsappReminder {
  id          String    @id @default(cuid())
  companyId   String
  peerNumber  String
  title       String
  description String?
  tag         String?
  dueAt       DateTime
  doneAt      DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, dueAt])
  @@index([companyId, peerNumber])
  @@index([companyId, doneAt])
}
