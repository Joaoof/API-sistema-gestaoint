generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("BANCO_URL")
  relationMode = "prisma"
}

model Gift {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal
  imageUrl    String?
  status      String   @default("available")
  reservedBy  String?
  createdAt   DateTime @default(now())
}

model Product {
  id          String              @id @default(uuid())
  nameProduct String              @unique
  kind        ProductKind         @default(PRODUCT)
  quantity    Int                 @default(0)
  costPrice   Decimal             @default(0.0)
  salePrice   Decimal             @default(0.0)
  status      ProductStatus       @default(ACTIVE)
  categoryId  String?
  supplierId  String?
  createdById String?
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  sku         String?
  minStock    Int                 @default(0)
  unit        String              @default("UN")
  weight      Decimal?            @db.Decimal
  category    Category?           @relation(fields: [categoryId], references: [id])
  supplier    Supplier?           @relation(fields: [supplierId], references: [id])
  createdBy   Users?              @relation(fields: [createdById], references: [id])
  images      ProductImage[]
  inventory   Inventory?
  receivables AccountReceivable[]
  payables    AccountPayable[]
  orderItems  OrderItem[]

  @@index([nameProduct])
  @@index([sku])
  @@index([status])
  @@index([categoryId])
  @@index([supplierId])
  @@index([kind])
}

/// Imagens de um produto armazenadas no Cloudflare R2.
/// `key` é a chave no bucket (ex: products/uuid-slug.jpg) — usada para deleção.
/// `url` é a URL pública servida (custom domain ou r2.cloudflarestorage.com).
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  key       String   @unique
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, order])
}

model Category {
  id          String         @id @default(uuid())
  name        String
  description String?
  color       String         @default("#3B82F6")
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userId      String?
  Product     Product[]
  user        Users?         @relation(fields: [userId], references: [id])

  @@index([name], map: "idx_category_name")
  @@index([status], map: "idx_category_status")
}

model Supplier {
  id         String                @id @default(cuid())
  name       String                @unique
  email      String?               @unique
  phone      String?
  address    String?
  createdAt  DateTime              @default(now())
  Product    Product[]
  payables   AccountPayable[]
  transacoes TransacaoFinanceira[]
}

model Customer {
  id            String              @id @default(uuid())
  name          String
  nomeFantasia  String?
  razaoSocial   String?
  document      String?
  email         String?
  phone         String?
  address       String?
  bairro        String?
  cidade        String?
  estado        String?
  cep           String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  receivables   AccountReceivable[]
  orders        Order[]
  obras         Obra[]
  messageLogs   MessageLog[]
  opportunities Opportunity[]
  contracts     Contract[]

  @@index([name])
  @@index([document])
}

model Order {
  id                   String             @id @default(uuid())
  number               Int                @default(autoincrement())
  customerId           String?
  customerName         String?
  customerDocument     String?
  customerPhone        String?
  sellerId             String?
  sellerName           String?
  commissionPercent    Decimal            @default(0)
  commissionAmount     Decimal            @default(0)
  status               OrderStatus        @default(CONFIRMED)
  paymentMethod        OrderPaymentMethod @default(CASH)
  orderType            OrderType          @default(STANDARD)
  expectedDeliveryDate DateTime?
  depositAmount        Decimal            @default(0)
  subtotal             Decimal            @default(0)
  discount             Decimal            @default(0)
  total                Decimal            @default(0)
  notes                String?
  dueDate              DateTime?
  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  customer             Customer?          @relation(fields: [customerId], references: [id])
  seller               Seller?            @relation(fields: [sellerId], references: [id])
  createdBy            Users?             @relation(fields: [createdById], references: [id])
  items                OrderItem[]
  delivery             Delivery?
  invoices             Invoice[]

  @@index([customerId])
  @@index([sellerId])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@index([orderType])
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  productId   String
  productName String
  itemKind    ProductKind @default(PRODUCT)
  itemUnit    String      @default("UN")
  quantity    Int
  unitPrice   Decimal
  discount    Decimal     @default(0)
  total       Decimal
  description String?
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([itemKind])
}

model Driver {
  id              String     @id @default(uuid())
  name            String
  photoUrl        String?
  cnh             String?
  cnhCategory     String?
  phone           String?
  document        String?
  vehicle         String?
  vehiclePlate    String?
  active          Boolean    @default(true)
  totalDeliveries Int        @default(0)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deliveries      Delivery[]

  @@index([active])
  @@index([name])
}

model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @unique
  kind           DeliveryKind   @default(DELIVERY)
  driverId       String?
  driver         String?
  driverPhotoUrl String?
  driverPhone    String?
  vehicle        String?
  destination    String?
  scheduledDate  DateTime?
  startedAt      DateTime?
  deliveredAt    DateTime?
  status         DeliveryStatus @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverRef      Driver?        @relation(fields: [driverId], references: [id])

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@index([scheduledDate])
  @@index([kind])
}

model AccountReceivable {
  id            String                @id @default(uuid())
  customerId    String
  productId     String?
  obraId        String?
  centroCustoId String?
  orderId       String?
  description   String
  amount        Decimal
  interestRate  Decimal               @default(0.033)
  dueDate       DateTime
  paidAt        DateTime?
  status        AccountStatus         @default(PENDING)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  customer      Customer              @relation(fields: [customerId], references: [id])
  product       Product?              @relation(fields: [productId], references: [id])
  obra          Obra?                 @relation(fields: [obraId], references: [id])
  centroCusto   CentroCusto?          @relation(fields: [centroCustoId], references: [id])
  transacoes    TransacaoFinanceira[]

  @@index([customerId])
  @@index([productId])
  @@index([obraId])
  @@index([centroCustoId])
  @@index([orderId])
  @@index([dueDate])
  @@index([status])
}

model AccountPayable {
  id            String                @id @default(uuid())
  supplierId    String?
  productId     String?
  obraId        String?
  centroCustoId String?
  supplierName  String
  description   String
  amount        Decimal
  interestRate  Decimal               @default(0.033)
  dueDate       DateTime
  paidAt        DateTime?
  status        AccountStatus         @default(PENDING)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  product       Product?              @relation(fields: [productId], references: [id])
  obra          Obra?                 @relation(fields: [obraId], references: [id])
  centroCusto   CentroCusto?          @relation(fields: [centroCustoId], references: [id])
  transacoes    TransacaoFinanceira[]

  @@index([supplierId])
  @@index([productId])
  @@index([obraId])
  @@index([centroCustoId])
  @@index([dueDate])
  @@index([status])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  minStock  Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])

  @@index([quantity])
}

model RecurringBill {
  id               String   @id @default(uuid())
  supplierName     String
  description      String
  amount           Decimal
  dayOfMonth       Int
  interestRate     Decimal  @default(0.033)
  notes            String?
  active           Boolean  @default(true)
  lastGeneratedFor String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String?
  model     String      @default("gpt-4o-mini")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt(sort: Desc)])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String // 'system' | 'user' | 'assistant' | 'tool'
  content        String         @db.Text
  toolCalls      Json? // OpenAI tool_calls payload
  toolCallId     String? // when role='tool'
  toolName       String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiPendingAction {
  id             String    @id @default(uuid())
  userId         String
  conversationId String?
  tool           String // ex: 'createAccountPayable'
  params         Json
  description    String // resumo legível pra confirmação
  status         String    @default("PENDING") // PENDING | EXECUTED | CANCELED | FAILED
  result         Json?
  error          String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([userId, status, createdAt(sort: Desc)])
}

model AiCreditAccount {
  id              String                @id @default(uuid())
  companyId       String                @unique
  balance         Int                   @default(0)
  lowThreshold    Int                   @default(50)
  totalPurchased  Int                   @default(0)
  totalConsumed   Int                   @default(0)
  lowNotifiedAt   DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  transactions    AiCreditTransaction[]
  purchases       AiCreditPurchase[]
}

model AiCreditTransaction {
  id           String          @id @default(uuid())
  accountId    String
  companyId    String
  kind         String // PURCHASE | CONSUMPTION | BONUS | REFUND | ADJUSTMENT
  amount       Int // pode ser negativo (consumo)
  balanceAfter Int
  refType      String? // ex: 'AiMessage', 'Purchase'
  refId        String?
  description  String
  userId       String?
  createdAt    DateTime        @default(now())
  account      AiCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

model AiCreditPurchase {
  id              String          @id @default(uuid())
  accountId       String
  companyId       String
  packageBrl      Int // valor em reais (50, 70, 100)
  creditsBase     Int
  creditsBonus    Int             @default(0)
  creditsTotal    Int // creditsBase + creditsBonus
  pixKey          String
  pixCopyPaste    String          @db.Text
  pixTxid         String          @unique
  status          String          @default("PENDING") // PENDING | PAID | CANCELED | EXPIRED
  paidAt          DateTime?
  paidByUserId    String? // super-admin que confirmou
  createdByUserId String
  notes           String?
  createdAt       DateTime        @default(now())
  expiresAt       DateTime
  account         AiCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ExportTemplate {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  name        String
  module      String // 'sales' | 'receivables' | 'payables' | 'movements' | 'inventory' | 'orders'
  format      String // 'CSV' | 'XLSX' | 'PDF'
  filters     Json
  columns     Json
  schedule    String? // ex: 'WEEKLY_MONDAY' | null
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
}

model Insight {
  id                String   @id @default(uuid())
  companyId         String
  kind              String // DAILY | WEEKLY | ALERT | MANUAL
  title             String
  body              String   @db.Text
  metricsJson       Json?
  generatedByModel  String
  creditsCost       Int      @default(0)
  deliveredChannels String[] // ['dashboard', 'notification', 'whatsapp', 'email']
  createdAt         DateTime @default(now())

  @@index([companyId, kind, createdAt(sort: Desc)])
}

model Company {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  nomeFantasia          String?
  razaoSocial           String?
  inscricaoEstadual     String?
  bairro                String?
  cidade                String?
  estado                String?
  cep                   String?
  email                 String?                @unique
  phone                 String?
  address               String?
  cnpj                  String?                @unique
  logoUrl               String?
  latitude              Float?
  longitude             Float?
  is_active             Boolean?               @default(true)
  createdAt             DateTime               @default(now())
  Users                 Users[]
  companyPlan           CompanyPlan?
  obras                 Obra[]
  centrosCusto          CentroCusto[]
  categoriasObra        CategoriaConstrucao[]
  versoesOrcamento      VersaoOrcamento[]
  transacoes            TransacaoFinanceira[]
  auditLogs             AuditLog[]
  fiscalConfig          CompanyFiscalConfig?
  invoices              Invoice[]
  settings              CompanySettings?
  financialAccounts     FinancialAccount[]
  notifications         Notification[]
  notificationTemplates NotificationTemplate[]
  messageLogs           MessageLog[]
  opportunities         Opportunity[]
  contracts             Contract[]
  whatsappInstance      WhatsappInstance?
  whatsappContacts      WhatsappContact[]
}

model Modules {
  id          String @id @default(cuid())
  name        String
  module_key  String
  description String
}

model Users {
  id                      String                @id @default(cuid())
  email                   String                @unique
  password_hash           String
  name                    String
  phone                   String?
  avatarUrl               String?
  company_id              String
  role                    String
  is_active               Boolean
  isSuperAdmin            Boolean               @default(false)
  createdAt               DateTime              @default(now())
  company                 Company?              @relation(fields: [company_id], references: [id])
  Product                 Product[]
  CashMovement            CashMovement[]
  Category                Category[]
  Order                   Order[]
  Bank                    Bank[]
  versoesOrcamentoCriadas VersaoOrcamento[]     @relation("VersaoOrcamentoCriadaPor")
  transacoesCriadas       TransacaoFinanceira[] @relation("TransacaoCriadaPor")
  transacoesConfirmadas   TransacaoFinanceira[] @relation("TransacaoConfirmadaPor")
  auditLogs               AuditLog[]
  invoicesCreated         Invoice[]             @relation("InvoiceCreatedBy")
  notifications           Notification[]

  @@index([company_id])
  @@index([company_id, email])
}

model Plan {
  id           String        @id @default(cuid())
  name         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  isActive     Boolean       @default(true)
  module       PlanModule[]
  companyPlans CompanyPlan[]
}

model Module {
  id          String       @id @default(cuid())
  name        String
  module_key  String       @unique
  description String?
  planModule  PlanModule[]
}

model PlanModule {
  id         String   @id @default(cuid())
  planId     String
  moduleId   String
  isActive   Boolean  @default(true)
  permission String[]
  plan       Plan     @relation(fields: [planId], references: [id])
  module     Module   @relation(fields: [moduleId], references: [id])
}

model CompanyPlan {
  id         String    @id @default(cuid())
  company_id String    @unique
  planId     String
  startDate  DateTime  @default(now())
  endDate    DateTime?
  isActive   Boolean   @default(true)
  company    Company   @relation(fields: [company_id], references: [id])
  plan       Plan      @relation(fields: [planId], references: [id])

  @@index([id], map: "idx_company_id")
}

model CashMovement {
  id                   String               @id @default(uuid())
  type                 MovementType
  category             MovementCategory
  value                Decimal
  description          String
  date                 DateTime             @default(now())
  user_id              String
  bankId               String?
  typePayment          MovementTypePayment?
  status               MovementStatus       @default(COMPLETED)
  referenceCode        String?
  counterpartyName     String?
  counterpartyDocument String?
  notes                String?
  attachmentUrl        String?
  dueDate              DateTime?
  paidAt               DateTime?
  orderId              String?
  accountReceivableId  String?
  accountPayableId     String?
  transferId           String?
  customerId           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 Users                @relation(fields: [user_id], references: [id])
  bank                 Bank?                @relation(fields: [bankId], references: [id])

  @@index([user_id, date(sort: Desc)])
  @@index([user_id, status])
  @@index([user_id, category])
  @@index([user_id, type])
  @@index([date])
  @@index([referenceCode])
  @@index([bankId])
  @@index([orderId])
  @@index([accountReceivableId])
  @@index([accountPayableId])
  @@index([transferId])
  @@index([customerId])
}

model Bank {
  id            String          @id @default(uuid())
  user_id       String
  name          String
  tipo          BankAccountType @default(CHECKING)
  agencia       String?
  conta         String?
  digito        String?
  titular       String?
  documento     String?
  pixKey        String?
  saldoInicial  Decimal         @default(0)
  corHex        String          @default("#3B82F6")
  ativo         Boolean         @default(true)
  observacoes   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          Users           @relation(fields: [user_id], references: [id])
  cashMovements CashMovement[]

  @@index([user_id])
  @@index([user_id, ativo])
  @@index([name])
}

model CommissionRuleConfig {
  id                    String             @id
  key                   String             @unique
  commissionType        CommissionRuleType
  commissionValue       Decimal
  pointsPerCurrencyUnit Decimal            @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
}

model Sale {
  id               String   @id
  sellerId         String
  totalAmount      Decimal
  commissionAmount Decimal
  pointsEarned     Int
  createdAt        DateTime @default(now())

  @@index([sellerId, createdAt(sort: Desc)])
}

model SaleItem {
  id         String  @id
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Decimal
  totalPrice Decimal

  @@index([productId])
  @@index([saleId])
}

model SalesCatalogProduct {
  id        String   @id
  name      String
  sku       String   @unique
  unitPrice Decimal
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Seller {
  id                String   @id @default(uuid())
  name              String
  email             String?  @unique
  phone             String?
  document          String?
  commissionPercent Decimal  @default(0)
  active            Boolean  @default(true)
  totalCommission   Decimal  @default(0)
  totalPoints       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            Order[]

  @@index([active])
  @@index([name])
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum MovementType {
  ENTRY
  EXIT
}

enum MovementCategory {
  SALE
  CHANGE
  OTHER_IN
  EXPENSE
  WITHDRAWAL
  PAYMENT
}

enum MovementTypePayment {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CHECK
  OTHER
}

enum MovementStatus {
  PENDING
  COMPLETED
  SCHEDULED
  CANCELED
  OVERDUE
}

enum EntryTypeClient {
  Sale
  Change
  Others
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductKind {
  PRODUCT
  SERVICE
  LABOR
}

enum OrderType {
  STANDARD
  CUSTOM_ORDER
}

enum BankAccountType {
  CHECKING
  SAVINGS
  WALLET
  INVESTMENT
  OTHER
}

enum AccountStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELED
  REFUNDED
}

enum OrderPaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  TRANSFER
  OTHER
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELED
}

enum DeliveryKind {
  DELIVERY
  PICKUP
}

enum CommissionRuleType {
  PERCENTAGE
  FIXED_PER_SALE
}

// =====================================================================
// MÓDULO CONSTRUÇÃO CIVIL
// Princípios:
//   - Previsto (orçamento) e Realizado (transação) NUNCA dividem tabela.
//   - Transação CONFIRMADA é imutável (correções via estorno).
//   - Versão de orçamento ATIVADA é imutável (mudanças via nova versão).
//   - Soft-delete em entidades operacionais; audit-log para mutações.
//   - Multi-tenancy por companyId em raízes (Obra, CentroCusto, Categoria,
//     VersaoOrcamento, TransacaoFinanceira).
// =====================================================================

model Obra {
  id            String                @id @default(uuid())
  companyId     String
  customerId    String?
  codigo        String
  nome          String
  descricao     String?
  endereco      String?
  cidade        String?
  estado        String?
  cep           String?
  latitude      Float?
  longitude     Float?
  status        ObraStatus            @default(PLANEJAMENTO)
  dataInicio    DateTime?
  dataFimPrev   DateTime?
  dataFimReal   DateTime?
  valorContrato Decimal?              @db.Decimal(18, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  company       Company               @relation(fields: [companyId], references: [id])
  customer      Customer?             @relation(fields: [customerId], references: [id])
  etapas        ObraEtapa[]
  versoes       VersaoOrcamento[]
  transacoes    TransacaoFinanceira[]
  payables      AccountPayable[]
  receivables   AccountReceivable[]

  @@unique([companyId, codigo])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([companyId, status])
  @@index([deletedAt])
}

model ObraEtapa {
  id             String                @id @default(uuid())
  obraId         String
  codigo         String
  nome           String
  ordem          Int                   @default(0)
  descricao      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  obra           Obra                  @relation(fields: [obraId], references: [id])
  subetapas      ObraSubetapa[]
  itens          ObraItemWBS[]
  itensOrcamento ItemOrcamento[]
  transacoes     TransacaoFinanceira[]

  @@unique([obraId, codigo])
  @@index([obraId])
  @@index([obraId, ordem])
}

model ObraSubetapa {
  id             String                @id @default(uuid())
  etapaId        String
  codigo         String
  nome           String
  ordem          Int                   @default(0)
  descricao      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
