model CompanySettings {
  id                     String   @id @default(uuid())
  companyId              String   @unique
  currency               String   @default("BRL")
  locale                 String   @default("pt-BR")
  timezone               String   @default("America/Sao_Paulo")
  dateFormat             String   @default("dd/MM/yyyy")
  timeFormat             String   @default("HH:mm")
  numberDecimals         Int      @default(2)
  numberDecimalSep       String   @default(",")
  numberThousandSep      String   @default(".")
  weekStartsOn           Int      @default(0)
  fiscalYearStartMonth   Int      @default(1)
  defaultPageSize        Int      @default(50)
  companyWhatsappNumber  String?
  companyWhatsappName    String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  company                Company  @relation(fields: [companyId], references: [id])
}

model FinancialAccount {
  id          String               @id @default(uuid())
  companyId   String
  code        String
  name        String
  type        FinancialAccountType
  parentId    String?
  active      Boolean              @default(true)
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  company     Company              @relation(fields: [companyId], references: [id])
  parent      FinancialAccount?    @relation("FinancialAccountTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children    FinancialAccount[]   @relation("FinancialAccountTree")

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([companyId, parentId])
}

enum FinancialAccountType {
  INCOME
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

// =====================================================================
// NOTIFICAÇÕES + COMUNICAÇÕES
// =====================================================================

model Notification {
  id           String               @id @default(uuid())
  companyId    String
  userId       String?
  type         NotificationType
  severity     NotificationSeverity @default(INFO)
  title        String
  message      String
  href         String?
  entity       String?
  entityId     String?
  metadataJson Json?
  readAt       DateTime?
  createdAt    DateTime             @default(now())
  expiresAt    DateTime?
  company      Company              @relation(fields: [companyId], references: [id])
  user         Users?               @relation(fields: [userId], references: [id])

  @@index([companyId, userId, readAt])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, type])
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  companyId String
  key       String
  channel   NotificationChannel
  name      String
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  company   Company             @relation(fields: [companyId], references: [id])

  @@unique([companyId, key, channel])
  @@index([companyId])
}

model MessageLog {
  id           String              @id @default(uuid())
  companyId    String
  channel      NotificationChannel
  direction    MessageDirection    @default(OUTBOUND)
  toAddress    String
  fromAddress  String?
  subject      String?
  body         String
  status       MessageStatus       @default(PENDING)
  externalId   String?
  errorMessage String?
  customerId   String?
  templateKey  String?
  metadataJson Json?
  createdAt    DateTime            @default(now())
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  company      Company             @relation(fields: [companyId], references: [id])
  customer     Customer?           @relation(fields: [customerId], references: [id])

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([externalId])
}

enum NotificationType {
  STOCK_LOW
  ORDER_PENDING
  INVOICE_DUE
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  DELIVERY_SCHEDULED
  DELIVERY_COMPLETED
  CUSTOM
  INFO
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
  PUSH
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

// =====================================================================
// CRM (Funil de vendas)
// =====================================================================

model Opportunity {
  id                String           @id @default(uuid())
  companyId         String
  customerId        String?
  customerName      String?
  customerPhone     String?
  customerEmail     String?
  title             String
  source            String?
  stage             OpportunityStage @default(NEW)
  value             Decimal          @default(0)
  probability       Int              @default(50)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  ownerUserId       String?
  sellerId          String?
  notes             String?
  lostReason        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company    Company               @relation(fields: [companyId], references: [id])
  customer   Customer?             @relation(fields: [customerId], references: [id])
  activities OpportunityActivity[]

  @@index([companyId, stage])
  @@index([companyId, ownerUserId])
  @@index([companyId, customerId])
  @@index([companyId, createdAt(sort: Desc)])
}

model OpportunityActivity {
  id               String                    @id @default(uuid())
  opportunityId    String
  type             OpportunityActivityType
  status           OpportunityActivityStatus @default(PENDING)
  title            String
  description      String?
  dueDate          DateTime?
  completedAt      DateTime?
  assignedToUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, dueDate])
  @@index([opportunityId, status])
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum OpportunityActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum OpportunityActivityStatus {
  PENDING
  COMPLETED
  CANCELED
}

// =====================================================================
// CONTRATOS + SLA
// =====================================================================

model Contract {
  id           String         @id @default(uuid())
  companyId    String
  customerId   String
  number       String
  title        String
  status       ContractStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  value        Decimal        @default(0)
  billingCycle BillingCycle   @default(ONCE)
  autoRenew    Boolean        @default(false)
  sellerId     String?
  description  String?
  terms        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company       Company         @relation(fields: [companyId], references: [id])
  customer      Customer        @relation(fields: [customerId], references: [id])
  serviceLevels ServiceLevel[]
  events        ContractEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, endDate])
}

model ServiceLevel {
  id             String           @id @default(uuid())
  contractId     String
  kind           ServiceLevelKind
  name           String
  description    String?
  targetValue    Decimal
  unit           String
  penaltyPercent Decimal          @default(0)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  contract Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  events   ServiceLevelEvent[]

  @@index([contractId])
}

model ServiceLevelEvent {
  id             String   @id @default(uuid())
  serviceLevelId String
  occurredAt     DateTime @default(now())
  measuredValue  Decimal
  met            Boolean
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())

  serviceLevel ServiceLevel @relation(fields: [serviceLevelId], references: [id], onDelete: Cascade)

  @@index([serviceLevelId, occurredAt(sort: Desc)])
  @@index([serviceLevelId, met])
}

model ContractEvent {
  id          String            @id @default(uuid())
  contractId  String
  type        ContractEventType
  occurredAt  DateTime          @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, occurredAt(sort: Desc)])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
  TERMINATED
}

enum BillingCycle {
  ONCE
  MONTHLY
  QUARTERLY
  ANNUAL
  WEEKLY
}

enum ServiceLevelKind {
  DELIVERY_TIME_HOURS
  RESPONSE_TIME_HOURS
  UPTIME_PERCENT
  QUALITY_SCORE
  CUSTOM
}

enum ContractEventType {
  CREATED
  ACTIVATED
  SUSPENDED
  RESUMED
  RENEWED
  TERMINATED
  EXPIRED
  AMENDED
  BREACH_REGISTERED
  NOTE
}

