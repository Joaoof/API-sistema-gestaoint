# Necessário porque @nestjs/apollo@13 tem conflito interno de peer deps:
# o pacote raiz exige @apollo/server@^5 mas seu plugin transitivo
# (apollo-server-plugin-landing-page-graphql-playground@4.0.1) exige @apollo/server@^4.
# `legacy-peer-deps` faz o npm seguir o comportamento antigo: instala mesmo com conflito.
legacy-peer-deps=true
